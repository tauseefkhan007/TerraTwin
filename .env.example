# TerraTwin local OAuth configuration. Never commit a real .env file.
TERRATWIN_FRONTEND_URL=http://localhost:8000
TERRATWIN_SESSION_SECRET=replace-with-a-long-random-string
TERRATWIN_COOKIE_SECURE=false

# Create a GitHub OAuth App with this callback URL:
# http://localhost:8001/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8001/auth/github/callback

# Create a Google OAuth Web Application with this callback URL:
# http://localhost:8001/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback
